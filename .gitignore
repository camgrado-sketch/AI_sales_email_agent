.env

# Data files (contains real customer info, logs, and runtime state)
data/
!data/.gitkeep

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Virtual environment
venv/
env/
ENV/
.venv/

# OS generated files
.DS_Store
Thumbs.db

# Runtime template archives
templates/archive/*
!templates/archive/.gitkeep
