#!/usr/bin/env bash
BRANCH_NAME=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$BRANCH_NAME" = "main" ] || [ "$BRANCH_NAME" = "develop" ]; then
  echo "Error: direct commits to '$BRANCH_NAME' are prohibited."
  echo "Create a feature/* or fix/* branch and open a PR to develop."
  exit 1
fi

PATTERN="^(feature|fix)/[a-zA-Z0-9._-]+$"
if [[ ! $BRANCH_NAME =~ $PATTERN ]]; then
  echo "Error: branch name '$BRANCH_NAME' is invalid."
  echo "Allowed: feature/xxx or fix/xxx"
  exit 1
fi
