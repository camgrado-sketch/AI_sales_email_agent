# Copy this file to .env and fill in your credentials
# IMPORTANT: .env is gitignored and must NEVER be committed to GitHub

# ---------------------------------------------------------------------------
# Tencent Enterprise Email (required)
# ---------------------------------------------------------------------------
EMAIL_ACCOUNT=your_email@yourdomain.com

# Client authorization code (NOT your login password)
# Get it from: Enterprise Email Web > Settings > Account > Client-specific password
EMAIL_PASSWORD=your_authorization_code_here

# ---------------------------------------------------------------------------
# Sender identity (optional, overridden by templates/sender_profile.md)
# ---------------------------------------------------------------------------
SENDER_NAME=Your Name
SENDER_TITLE=Partnership Manager
SENDER_MARKET_REGION=Global
SENDER_PHONE=+86 138 0000 0000
SENDER_EMAIL=your_email@yourdomain.com

# ---------------------------------------------------------------------------
# Option A: Multi-model configuration (recommended)
# Add as many MODEL_N_* blocks as you like. The first valid block is index 0.
# Required per block: NAME, API_KEY, MODEL
# Optional per block: BASE_URL, TEMPERATURE
# ---------------------------------------------------------------------------
# MODEL_1_NAME=moonshot
# MODEL_1_BASE_URL=https://api.moonshot.cn/v1
# MODEL_1_API_KEY=your_moonshot_api_key
# MODEL_1_MODEL=kimi-k2.6
# MODEL_1_TEMPERATURE=1.0
#
# MODEL_2_NAME=openai
# MODEL_2_BASE_URL=https://api.openai.com/v1
# MODEL_2_API_KEY=your_openai_api_key
# MODEL_2_MODEL=gpt-4o-mini
# MODEL_2_TEMPERATURE=0.7

# ---------------------------------------------------------------------------
# Option B: Legacy single-model configuration (fallback)
# Only used when no MODEL_* blocks are defined above.
# ---------------------------------------------------------------------------
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: force a specific active model index at startup
# ACTIVE_MODEL_INDEX=0
